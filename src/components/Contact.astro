---
// Direct Contact Section - Clean Light Theme without quotation calculators
---

<section id="contacto" class="contact-section">
	<div class="contact-container">
		<div class="contact-grid">
			<!-- Contact Info -->
			<div class="contact-info">
				<span class="contact-badge">CONTACTO DIRECTO</span>
				<h2 class="contact-title">
					¿Tienes un proyecto en mente? <span class="highlight">Hablemos hoy.</span>
				</h2>
				<p class="contact-desc">
					Conéctate directamente con nuestro equipo de ingenieros para evaluar la viabilidad técnica y los plazos de tu solución de software.
				</p>

				<div class="contact-cards">
					<a href="mailto:contacto@vesla.tech" class="channel-card">
						<div class="channel-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
								<polyline points="22,6 12,13 2,6"/>
							</svg>
						</div>
						<div>
							<h4>Correo Electrónico</h4>
							<p>contacto@vesla.tech</p>
						</div>
					</a>

					<a href="https://wa.me/573001234567" target="_blank" rel="noopener noreferrer" class="channel-card">
						<div class="channel-icon whatsapp">
							<svg viewBox="0 0 24 24" fill="currentColor">
								<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.79 14.04c-.24.67-1.4 1.24-1.93 1.32-.49.08-1.13.12-3.64-.91-3.21-1.32-5.26-4.6-5.42-4.81-.16-.22-1.3-1.74-1.3-3.32 0-1.58.82-2.35 1.12-2.67.29-.32.64-.4.86-.4.21 0 .43 0 .62.01.2.01.47-.08.74.56.28.67.95 2.32 1.03 2.49.08.17.14.37.03.6-.11.22-.17.37-.34.56-.17.2-.36.44-.51.59-.17.17-.35.35-.15.7.2.35.88 1.45 1.88 2.35 1.3 1.15 2.39 1.51 2.74 1.68.35.17.55.15.76-.09.21-.24.89-1.04 1.13-1.4.24-.35.49-.3.82-.17.33.12 2.11 1 2.47 1.17.36.18.6.27.69.42.09.15.09.89-.15 1.56z"/>
							</svg>
						</div>
						<div>
							<h4>WhatsApp Directo</h4>
							<p>Respuesta rápida en minutos</p>
						</div>
					</a>

					<div class="channel-card">
						<div class="channel-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
								<line x1="16" y1="2" x2="16" y2="6"/>
								<line x1="8" y1="2" x2="8" y2="6"/>
								<line x1="3" y1="10" x2="21" y2="10"/>
							</svg>
						</div>
						<div>
							<h4>Reunión Técnica de 20 min</h4>
							<p>Lunes a Viernes de 8:00 a 18:00</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Direct Message Form -->
			<div class="contact-form-card glass-card">
				<form id="contact-form" class="message-form">
					<div class="form-group">
						<label for="contact-name" class="form-label">Nombre Completo</label>
						<input type="text" id="contact-name" required placeholder="Ej. Carlos Mendoza" class="form-input" />
					</div>

					<div class="form-group">
						<label for="contact-email" class="form-label">Correo Electrónico</label>
						<input type="email" id="contact-email" required placeholder="carlos@empresa.com" class="form-input" />
					</div>

					<div class="form-group">
						<label for="contact-phone" class="form-label">Teléfono o WhatsApp</label>
						<input type="tel" id="contact-phone" placeholder="+57 300 123 4567" class="form-input" />
					</div>

					<div class="form-group">
						<label for="contact-message" class="form-label">Mensaje o requerimiento</label>
						<textarea id="contact-message" rows="4" required placeholder="Cuéntanos brevemente qué buscas construir o resolver..." class="form-textarea"></textarea>
					</div>

					<button type="submit" id="contact-btn" class="submit-btn">
						<span>Enviar Mensaje</span>
						<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
					</button>

					<div id="contact-success" class="contact-success" style="display: none;">
						✓ ¡Mensaje enviado con éxito! Te responderemos hoy mismo.
					</div>
				</form>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('contact-form');
		const btn = document.getElementById('contact-btn');
		const msg = document.getElementById('contact-success');

		if (form && btn && msg) {
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				btn.disabled = true;
				btn.style.opacity = '0.6';
				btn.innerHTML = '<span>Enviando...</span>';

				setTimeout(() => {
					form.reset();
					btn.style.display = 'none';
					msg.style.display = 'block';
				}, 500);
			});
		}
	});
</script>

<style>
	.contact-section {
		padding: clamp(60px, 9vh, 110px) clamp(20px, 4vw, 56px);
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
	}

	.contact-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		gap: clamp(40px, 6vw, 80px);
		align-items: center;
	}

	.contact-badge {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: #0284c7;
		margin-bottom: 14px;
		display: inline-block;
		background: #e0f2fe;
		padding: 4px 12px;
		border-radius: 9999px;
	}

	.contact-title {
		font-size: clamp(32px, 4.6vw, 52px);
		line-height: 1.15;
		color: #0f172a;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 18px;
	}

	.highlight {
		color: #0284c7;
	}

	.contact-desc {
		font-size: 16px;
		line-height: 1.6;
		color: #475569;
		margin-bottom: 34px;
	}

	.contact-cards {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.channel-card {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 20px;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 14px;
		text-decoration: none;
		color: #0f172a;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.channel-card:hover {
		transform: translateY(-2px);
		border-color: #0284c7;
		box-shadow: 0 10px 20px -5px rgba(2, 132, 199, 0.1);
	}

	.channel-icon {
		width: 42px;
		height: 42px;
		border-radius: 10px;
		background: #e0f2fe;
		color: #0284c7;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.channel-icon.whatsapp {
		background: #dcfce7;
		color: #16a34a;
	}

	.channel-icon svg {
		width: 22px;
		height: 22px;
	}

	.channel-card h4 {
		font-size: 15px;
		font-weight: 600;
		color: #0f172a;
		margin-bottom: 2px;
	}

	.channel-card p {
		font-size: 13.5px;
		color: #64748b;
	}

	/* Form Card */
	.contact-form-card {
		padding: clamp(28px, 4vw, 42px);
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 20px;
		box-shadow: 0 14px 35px -5px rgba(15, 23, 42, 0.05);
	}

	.message-form {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.form-label {
		font-size: 13.5px;
		font-weight: 600;
		color: #334155;
	}

	.form-input, .form-textarea {
		width: 100%;
		padding: 12px 16px;
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 8px;
		color: #0f172a;
		font-size: 14.5px;
		font-family: inherit;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.form-input:focus, .form-textarea:focus {
		outline: none;
		border-color: #0284c7;
		box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
	}

	.submit-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 14px 24px;
		background: #0284c7;
		color: #ffffff;
		border: none;
		border-radius: 8px;
		font-size: 15px;
		font-weight: 600;
		font-family: inherit;
		cursor: pointer;
		margin-top: 6px;
		box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
		transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
	}

	.submit-btn:hover {
		background: #0369a1;
		transform: translateY(-1px);
		box-shadow: 0 8px 20px rgba(2, 132, 199, 0.4);
	}

	.submit-btn svg {
		width: 17px;
		height: 17px;
	}

	.contact-success {
		padding: 14px;
		background: #dcfce7;
		border: 1px solid #86efac;
		border-radius: 8px;
		color: #166534;
		font-size: 14px;
		text-align: center;
		font-weight: 500;
	}

	@media (max-width: 868px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

