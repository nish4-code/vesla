---
import { faqItems } from "../data/faq";

const labelClass = "font-label-stratum font-bold uppercase no-underline";
const focusClass =
	"focus-visible:[outline:1px_solid_rgba(232,209,203,0.6)] focus-visible:[outline-offset:5px]";
const containerClass =
	"mx-auto w-[min(1240px,calc(100%-clamp(40px,8vw,128px)))] max-[680px]:w-[calc(100%-40px)]";
const eyebrowClass =
	"eyebrow m-0 text-[clamp(9px,0.72vw,11px)] tracking-[0.2em] text-[rgba(232,209,203,0.58)]";
---

<section
	class="faq scroll-mt-[clamp(88px,8vw,112px)] border-t border-[rgba(232,209,203,0.14)] bg-[#05080e] py-[clamp(76px,10vw,152px)] text-cream"
	id="preguntas"
	aria-labelledby="preguntas-title"
>
	<div class={containerClass}>
		<div class="grid grid-cols-[minmax(260px,0.62fr)_minmax(0,1.38fr)] gap-[clamp(44px,8vw,132px)] max-[1020px]:grid-cols-1 max-[1020px]:gap-[42px]">
			<header class="lg:sticky lg:top-[clamp(96px,9vw,118px)] lg:self-start">
				<p class:list={[labelClass, eyebrowClass]}>ANTES DE EMPEZAR</p>
				<h2
					class="mb-[clamp(22px,3vw,34px)] mt-5 max-w-[10ch] text-[clamp(34px,4.4vw,66px)] font-normal uppercase leading-[0.94] tracking-[-0.04em]"
					id="preguntas-title"
				>
					Preguntas <span class="text-white">concretas</span>.
				</h2>
				<p class="m-0 max-w-[34ch] text-[clamp(14px,1vw,16.5px)] leading-[1.68] text-[rgba(232,209,203,0.58)]">
					Lo que suele aparecer antes de empezar. Si falta algo, escribinos y lo
					resolvemos en una llamada corta.
				</p>
			</header>

			<div class="border-t border-[rgba(232,209,203,0.18)]">
				{
					faqItems.map((item) => (
						<details class="group border-b border-[rgba(232,209,203,0.18)]">
							<summary
								class:list={[
									focusClass,
									"flex cursor-pointer list-none items-start justify-between gap-6 py-[clamp(20px,2.4vw,30px)] text-[clamp(16px,1.35vw,21px)] leading-[1.35] text-[rgba(232,209,203,0.78)] transition-colors duration-300 hover:text-white group-open:text-white [&::-webkit-details-marker]:hidden",
								]}
							>
								<span>{item.question}</span>
								<span
									class="relative mt-[0.35em] block h-3.5 w-3.5 flex-none transition-[rotate] duration-300 ease-[var(--e-soft)] group-open:rotate-45"
									aria-hidden="true"
								>
									<span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current"
									></span>
									<span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current"
									></span>
								</span>
							</summary>
							<p class="mb-[clamp(22px,2.6vw,32px)] mt-0 max-w-[62ch] pr-[clamp(0px,4vw,56px)] text-[clamp(13.5px,0.98vw,16px)] leading-[1.7] text-[rgba(232,209,203,0.56)]">
								{item.answer}
							</p>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>
