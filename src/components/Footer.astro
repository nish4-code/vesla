---
import Wordmark from "./Wordmark.astro";

const labelClass =
	"font-label-stratum font-bold uppercase no-underline";
const focusClass =
	"focus-visible:[outline:1px_solid_rgba(232,209,203,0.6)] focus-visible:[outline-offset:5px]";
---

<footer
	class="foot relative overflow-hidden border-t border-[rgba(232,209,203,0.14)] bg-[#04070d] text-cream scroll-mt-[clamp(88px,8vw,112px)]"
	id="contacto"
>
	<div
		class="foot-orb pointer-events-none absolute -right-[10%] -top-[30%] h-[min(62vw,720px)] w-[min(62vw,720px)] rounded-full bg-[radial-gradient(circle,rgba(232,209,203,0.07),transparent_66%)]"
		aria-hidden="true"
	></div>
	<div
		class="foot-inner relative mx-auto w-[min(1240px,calc(100%-clamp(40px,8vw,128px)))] max-[680px]:w-[calc(100%-40px)]"
	>
		<div
			class="cta-wrap grid grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] items-end gap-[clamp(36px,6vw,104px)] py-[clamp(64px,8vw,112px)] max-[1020px]:grid-cols-1 max-[1020px]:gap-9"
		>
			<div class="cta-left">
				<p
					class:list={[
						labelClass,
						"eyebrow mb-[clamp(20px,2.4vw,30px)] mt-0 text-[clamp(8.5px,0.66vw,10px)] tracking-[0.2em] text-[rgba(232,209,203,0.46)]",
					]}
				>
					HABLEMOS
				</p>
				<h2
					class="m-0 max-w-[14ch] text-[clamp(38px,6.4vw,92px)] font-normal uppercase leading-[0.92] tracking-[-0.04em]"
				>
					¿Construimos algo <span class="text-white">que sirva</span>?
				</h2>
			</div>
			<div class="cta-right max-w-[340px] justify-self-end max-[1020px]:max-w-none max-[1020px]:justify-self-auto">
				<p
					class="mb-8 mt-0 text-[clamp(13px,1vw,16px)] leading-[1.65] text-[rgba(232,209,203,0.58)]"
				>
					Contanos qué proceso querés ordenar, automatizar o construir. Te respondemos
					con un diagnóstico inicial sin vueltas.
				</p>
				<a
					class:list={[
						labelClass,
						focusClass,
						"button group flex h-[clamp(46px,4.6vw,54px)] w-full items-center justify-between bg-cream px-[clamp(18px,2vw,24px)] text-[clamp(9px,0.7vw,10.5px)] tracking-[0.16em] text-ink transition-colors duration-300 ease-[ease] hover:bg-[#f3e1dc] [clip-path:polygon(0_0,calc(100%-15px)_0,100%_15px,100%_100%,0_100%)]",
					]}
					href="mailto:hola@vesla.tech"
				>
					<span>ESCRIBINOS</span>
					<svg
						class="h-[11px] w-[11px] flex-none stroke-current transition-[translate] duration-300 ease-[var(--e-soft)] group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
						viewBox="0 0 10 10"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path d="M1 9 L9 1 M3 1 H9 V7" fill="none" stroke-width="1.2"></path>
					</svg>
				</a>
				<p
					class:list={[
						labelClass,
						"mail mt-[18px] text-[clamp(8px,0.62vw,9.5px)] tracking-[0.1em] text-[rgba(232,209,203,0.36)]",
					]}
				>
					O DIRECTO A <a
						class:list={[focusClass, "text-[rgba(232,209,203,0.62)]"]}
						href="mailto:hola@vesla.tech">HOLA@VESLA.TECH</a
					>
				</p>
			</div>
		</div>

		<div
			class="foot-bottom grid grid-cols-[1fr_auto_1fr] items-center gap-6 border-t border-[rgba(232,209,203,0.14)] py-[clamp(22px,2.6vw,34px)] max-[680px]:grid-cols-1 max-[680px]:justify-items-start max-[680px]:gap-5"
		>
			<a
				class:list={[
					"footer-logo group",
					focusClass,
					"block w-[clamp(92px,8vw,118px)] text-cream transition-opacity duration-300 ease-[ease] hover:opacity-70",
				]}
				href="#"
				aria-label="Vesla — inicio"
			>
				<Wordmark
					class="block h-auto w-full fill-current [.anim_&]:animate-[maskUp_0.8s_var(--e-mask)_0.16s_both]"
				/>
			</a>
			<p
				class:list={[
					labelClass,
					"copy m-0 text-center text-[clamp(8px,0.62vw,9.5px)] tracking-[0.12em] text-[rgba(232,209,203,0.32)] max-[680px]:text-left",
				]}
			>
				© 2026 VESLA. BUENOS AIRES, ARGENTINA.
			</p>
			<nav
				class="foot-links flex items-center justify-end gap-[clamp(14px,1.8vw,24px)] max-[680px]:justify-start"
				aria-label="Enlaces legales"
			>
				<a
					class:list={[
						labelClass,
						focusClass,
						"text-[clamp(8px,0.62vw,9.5px)] tracking-[0.14em] text-[rgba(232,209,203,0.42)] transition-colors duration-300 ease-[ease] hover:text-cream",
					]}
					href="#"
				>
					PRIVACIDAD
				</a>
				<a
					class:list={[
						labelClass,
						focusClass,
						"text-[clamp(8px,0.62vw,9.5px)] tracking-[0.14em] text-[rgba(232,209,203,0.42)] transition-colors duration-300 ease-[ease] hover:text-cream",
					]}
					href="#"
				>
					TÉRMINOS
				</a>
				<a
					class:list={[
						labelClass,
						focusClass,
						"text-[clamp(8px,0.62vw,9.5px)] tracking-[0.14em] text-[rgba(232,209,203,0.42)] transition-colors duration-300 ease-[ease] hover:text-cream",
					]}
					href="#"
				>
					LINKEDIN
				</a>
			</nav>
		</div>
	</div>
</footer>
