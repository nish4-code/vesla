<style>
	.site-footer {
		background: #f1f5f9;
		border-top: 1px solid #e2e8f0;
		padding: clamp(50px, 7vh, 80px) clamp(20px, 4vw, 56px) 36px;
		color: #0f172a;
	}

	.footer-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.footer-top-grid {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: clamp(40px, 6vw, 80px);
		margin-bottom: 48px;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 16px;
	}

	.footer-mark {
		width: 28px;
		height: 28px;
		fill: #0284c7;
		flex-shrink: 0;
	}

	.footer-wordmark {
		font-size: 24px;
		font-weight: 700;
		color: #0f172a;
		letter-spacing: -0.02em;
	}

	.wordmark-dot {
		color: #0284c7;
	}

	.footer-tagline {
		font-size: 14.5px;
		line-height: 1.6;
		color: #64748b;
		max-width: 360px;
	}

	.footer-nav-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}

	.column-title {
		font-size: 13.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #0f172a;
		margin-bottom: 18px;
	}

	.column-links {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.column-links a {
		font-size: 14px;
		color: #475569;
		text-decoration: none;
		transition: color 0.2s, transform 0.2s;
		display: inline-block;
	}

	.column-links a:hover {
		color: #0284c7;
		transform: translateX(2px);
	}

	.footer-rule {
		height: 1px;
		background: #cbd5e1;
		margin-bottom: 28px;
	}

	.footer-bottom-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px;
	}

	.footer-legal {
		font-size: 13.5px;
		color: #64748b;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.social-link {
		width: 22px;
		height: 22px;
		color: #475569;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: color 0.2s;
	}

	.social-link svg {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.social-link:hover {
		color: #0284c7;
	}

	@media (max-width: 900px) {
		.footer-top-grid {
			grid-template-columns: 1fr;
		}

		.footer-nav-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.footer-nav-grid {
			grid-template-columns: 1fr;
		}

		.footer-bottom-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
