---
import HeroBackground from "./hero/HeroBackground.astro";
import HeroDock from "./hero/HeroDock.astro";
import HeroHeader from "./hero/HeroHeader.astro";
import HeroRail from "./hero/HeroRail.astro";
import HeroShowcase from "./hero/HeroShowcase.astro";
---

<div class="stage relative h-dvh min-h-[560px] overflow-hidden">
	<HeroBackground />
	<div
		class="topbar pointer-events-none fixed inset-x-0 top-0 z-40 h-[calc(30*var(--u)+58*var(--t))] bg-[linear-gradient(to_bottom,rgba(4,7,13,0.92),rgba(4,7,13,0.62))] opacity-0 backdrop-blur-[calc(18*var(--t))] transition-opacity duration-[350ms] ease-[ease] [.is-scrolled_&]:opacity-100"
		aria-hidden="true"
	></div>
	<div
		class="frame absolute top-[calc(30*var(--u))] right-[calc(30*var(--u))] bottom-[calc(31*var(--u))] left-[calc(30*var(--u))] max-[548px]:top-[calc(22*var(--u))] max-[548px]:right-[calc(22*var(--u))] max-[548px]:bottom-[calc(22*var(--u))] max-[548px]:left-[calc(22*var(--u))]"
	>
		<HeroHeader />
		<HeroRail />
		<HeroShowcase />
		<HeroDock />
	</div>
</div>

<script src="../scripts/hero/index.ts"></script>
