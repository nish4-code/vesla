---
// Metrics Component - Light Theme with Rubik
const metrics = [
	{
		value: "< 0.6s",
		label: "Velocidad de Carga",
		detail: "Score 100/100 en Google PageSpeed para cada landing page entregada."
	},
	{
		value: "85%",
		label: "Ahorro de Tiempo con RPA",
		detail: "Reducción promedio en horas operativas manuales y conciliaciones repetitivas."
	},
	{
		value: "99.98%",
		label: "Disponibilidad de Sistemas",
		detail: "Arquitectura resiliente en la nube con monitoreo continuo y cero caídas."
	},
	{
		value: "+1.5M",
		label: "Comprobantes Fiscales",
		detail: "Facturas y documentos electrónicos procesados y validados sin contratiempos."
	}
];
---

<section id="metricas" class="metrics-section">
	<div class="metrics-container">
		<div class="metrics-grid">
			{metrics.map((item) => (
				<div class="metric-card glass-card">
					<div class="metric-value">{item.value}</div>
					<div class="metric-label">{item.label}</div>
					<p class="metric-detail">{item.detail}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.metrics-section {
		padding: clamp(30px, 5vh, 60px) clamp(20px, 4vw, 56px);
		background: #f8fafc;
	}

	.metrics-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.metric-card {
		padding: 32px 24px;
		text-align: center;
		background: #ffffff;
		border: 1px solid rgba(226, 232, 240, 0.9);
		border-radius: 16px;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 8px 10px -6px rgba(15, 23, 42, 0.02);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.metric-card:hover {
		transform: translateY(-4px);
		border-color: rgba(2, 132, 199, 0.4);
		box-shadow: 0 20px 35px -5px rgba(2, 132, 199, 0.12);
	}

	.metric-value {
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 800;
		color: #0f172a;
		line-height: 1.1;
		margin-bottom: 8px;
		letter-spacing: -0.03em;
	}

	.metric-label {
		font-size: 14px;
		font-weight: 600;
		color: #0284c7;
		margin-bottom: 8px;
		letter-spacing: -0.01em;
	}

	.metric-detail {
		font-size: 13.5px;
		line-height: 1.5;
		color: #64748b;
	}

	@media (max-width: 1024px) {
		.metrics-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 580px) {
		.metrics-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
