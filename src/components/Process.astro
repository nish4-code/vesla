---
import { processSteps } from "../data/process";

const labelClass = "font-label-stratum font-bold uppercase no-underline";
const focusClass =
	"focus-visible:[outline:1px_solid_rgba(232,209,203,0.6)] focus-visible:[outline-offset:5px]";
const containerClass =
	"mx-auto w-[min(1240px,calc(100%-clamp(40px,8vw,128px)))] max-[680px]:w-[calc(100%-40px)]";
const eyebrowClass =
	"eyebrow m-0 text-[clamp(9px,0.72vw,11px)] tracking-[0.2em] text-[rgba(232,209,203,0.58)]";
const arrowClass =
	"h-[10px] w-[10px] flex-none stroke-current transition-[translate] duration-300 ease-[var(--e-soft)] group-hover:translate-x-[2px] group-hover:-translate-y-[2px] group-focus-visible:translate-x-[2px] group-focus-visible:-translate-y-[2px]";
const pad = (value: number) => String(value).padStart(2, "0");
---

<section
	class="process relative overflow-hidden scroll-mt-[clamp(88px,8vw,112px)] border-t border-[rgba(232,209,203,0.14)] bg-[#04070d] bg-[radial-gradient(circle_at_16%_18%,rgba(232,209,203,0.055),transparent_32%)] py-[clamp(76px,10vw,152px)] text-cream"
	id="proceso"
	aria-labelledby="proceso-title"
>
	<div class={containerClass}>
		<div class="grid grid-cols-[minmax(260px,0.72fr)_minmax(0,1.28fr)] gap-[clamp(48px,8vw,132px)] max-[1020px]:grid-cols-1 max-[1020px]:gap-[46px]">
			<header class="lg:sticky lg:top-[clamp(96px,9vw,118px)] lg:self-start">
				<p class:list={[labelClass, eyebrowClass]}>CÓMO TRABAJAMOS</p>
				<h2
					class="mb-[clamp(24px,3vw,38px)] mt-5 max-w-[12ch] text-[clamp(34px,4.4vw,66px)] font-normal uppercase leading-[0.94] tracking-[-0.04em]"
					id="proceso-title"
				>
					Un proceso corto, con <span class="text-white">entregas visibles</span>.
				</h2>
				<p class="m-0 max-w-[38ch] text-[clamp(14px,1vw,16.5px)] leading-[1.68] text-[rgba(232,209,203,0.58)]">
					No empezamos por la tecnología. Empezamos por entender qué se trabaja hoy,
					qué se pierde en el camino y cuál es la primera entrega que cambia algo.
				</p>
				<a
					class:list={[
						labelClass,
						focusClass,
						"group mt-8 inline-flex items-center gap-3 border-b border-[rgba(232,209,203,0.36)] pb-[9px] text-[clamp(8.5px,0.66vw,10px)] tracking-[0.16em] text-cream transition-[color,border-color] duration-300 ease-[var(--e-soft)] hover:border-white hover:text-white",
					]}
					href="#contacto"
				>
					<span>CONTANOS TU CASO</span>
					<svg
						class={arrowClass}
						viewBox="0 0 10 10"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path d="M1 9 L9 1 M3 1 H9 V7" fill="none" stroke-width="1.2" />
					</svg>
				</a>
			</header>

			<div class="relative pl-[clamp(18px,2.4vw,32px)]" data-process>
				<span
					class="absolute left-0 top-0 h-full w-px bg-[rgba(232,209,203,0.12)]"
					aria-hidden="true"></span>
				<span
					class="absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-[rgba(232,209,203,0.56)]"
					data-process-line
					aria-hidden="true"></span>
				<div class="border-t border-[rgba(232,209,203,0.16)]" data-process-track>
					{
						processSteps.map((step, index) => (
							<article class="group grid grid-cols-[clamp(50px,5vw,72px)_minmax(0,1fr)_minmax(120px,0.36fr)] items-start gap-[clamp(14px,2vw,28px)] border-b border-[rgba(232,209,203,0.16)] py-[clamp(24px,3.2vw,42px)] transition-colors duration-300 hover:bg-[rgba(232,209,203,0.025)] max-[680px]:grid-cols-[42px_minmax(0,1fr)] max-[680px]:gap-x-4">
								<span
									class:list={[
										labelClass,
										"pt-[0.35em] text-[clamp(12px,1.15vw,17px)] tracking-[0.1em] text-[rgba(232,209,203,0.34)] transition-colors duration-300 group-hover:text-cream",
									]}
								>
									{pad(index + 1)}
								</span>
								<div>
									<h3 class="m-0 text-[clamp(22px,2vw,32px)] font-normal uppercase leading-[1.02] tracking-[-0.025em]">
										{step.title}
									</h3>
									<p class="mb-0 mt-3 max-w-[52ch] text-[clamp(13.5px,0.98vw,16px)] leading-[1.64] text-[rgba(232,209,203,0.54)]">
										{step.body}
									</p>
								</div>
								<p
									class:list={[
										labelClass,
										"m-0 justify-self-end text-right text-[clamp(8px,0.62vw,9.5px)] leading-[1.6] tracking-[0.16em] text-[rgba(232,209,203,0.36)] max-[680px]:col-start-2 max-[680px]:justify-self-start max-[680px]:text-left",
									]}
								>
									{step.output}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script src="../scripts/process/index.ts"></script>
