---
// Agile Methodology & Process - Light Theme with Rubik
const steps = [
	{
		number: "01",
		title: "Diagnóstico & Arquitectura",
		desc: "Analizamos a fondo los procesos de tu negocio, cuellos de botella y requisitos fiscales o técnicos. Definimos la arquitectura óptima antes de escribir una sola línea de código."
	},
	{
		number: "02",
		title: "Prototipado Interactivo UI/UX",
		desc: "Diseñamos interfaces interactivas de alta fidelidad que combinan elegancia visual, navegación sin fricción y alta conversión, validadas directamente con tu equipo."
	},
	{
		number: "03",
		title: "Desarrollo por Sprints Semanales",
		desc: "Implementamos el software con código modular y testeado. Cada semana tienes acceso a un entorno de staging para probar avances funcionales reales."
	},
	{
		number: "04",
		title: "Testing Riguroso & Despliegue",
		desc: "Pruebas de carga, verificación de seguridad, validación tributaria y despliegue automatizado con monitoreo continuo para garantizar cero errores en producción."
	}
];
---

<section id="metodologia" class="process-section">
	<div class="process-container">
		<div class="process-header">
			<span class="process-badge">METODOLOGÍA TRANSPARENTE</span>
			<h2 class="process-title">
				De la idea a producción en <span class="highlight">semanas, no meses</span>
			</h2>
			<p class="process-subtitle">
				Un proceso de desarrollo sin sorpresas ni sobrecostos. Comunicación directa con ingenieros de software senior y visibilidad total del progreso.
			</p>
		</div>

		<div class="steps-grid">
			{steps.map((step) => (
				<div class="step-card glass-card">
					<div class="step-number">{step.number}</div>
					<h3 class="step-title">{step.title}</h3>
					<p class="step-desc">{step.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.process-section {
		padding: clamp(60px, 9vh, 110px) clamp(20px, 4vw, 56px);
		background: #f8fafc;
	}

	.process-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.process-header {
		text-align: center;
		max-width: 800px;
		margin: 0 auto clamp(40px, 6vh, 64px);
	}

	.process-badge {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: #0284c7;
		margin-bottom: 14px;
		display: inline-block;
		background: #e0f2fe;
		padding: 4px 12px;
		border-radius: 9999px;
	}

	.process-title {
		font-size: clamp(32px, 4.6vw, 52px);
		line-height: 1.15;
		color: #0f172a;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 16px;
	}

	.highlight {
		color: #0284c7;
	}

	.process-subtitle {
		font-size: clamp(15.5px, 1.5vw, 17.5px);
		line-height: 1.6;
		color: #475569;
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 22px;
	}

	.step-card {
		padding: 34px 26px;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 18px;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.step-card:hover {
		transform: translateY(-4px);
		border-color: rgba(2, 132, 199, 0.4);
		box-shadow: 0 20px 35px -5px rgba(2, 132, 199, 0.12);
	}

	.step-number {
		font-size: 38px;
		font-weight: 800;
		color: #0284c7;
		line-height: 1;
		margin-bottom: 16px;
		letter-spacing: -0.03em;
	}

	.step-title {
		font-size: 19px;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.3;
		margin-bottom: 12px;
		letter-spacing: -0.01em;
	}

	.step-desc {
		font-size: 14px;
		line-height: 1.6;
		color: #64748b;
	}

	@media (max-width: 1024px) {
		.steps-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.steps-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
