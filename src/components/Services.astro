---
// Services & Solutions Component - Light Theme with Rubik
const services = [
	{
		id: "landing-pages",
		tag: "ALTA CONVERSIÓN",
		title: "Landing Pages & Sitios de Alto Rendimiento",
		desc: "Diseños que cautivan y convierten visitantes en clientes calificados. Velocidad de carga sub-segundo (100/100 Lighthouse), animaciones fluidas, SEO técnico y optimización para campañas publicitarias (Google Ads / Meta).",
		features: [
			"Score 98-100 en Google PageSpeed",
			"Diseño responsive pixel-perfect",
			"A/B testing e instrumentación analítica",
			"Arquitectura estática con Astro"
		],
		badge: "Carga < 0.6s",
		badgeBg: "#e0f2fe",
		badgeColor: "#0284c7"
	},
	{
		id: "sistemas-completos",
		tag: "ARQUITECTURA EMPRESARIAL",
		title: "Sistemas Completos a Medida (ERP / CRM)",
		desc: "Construimos la columna vertebral tecnológica de tu empresa: plataformas web robustas, paneles de control administrativos, gestión de inventarios, finanzas, ventas y portales de autogestión para clientes.",
		features: [
			"Gestión de roles y permisos granulares (RBAC)",
			"Bases de datos relacionales resilientes (PostgreSQL)",
			"Reportes y tableros BI en tiempo real",
			"Escalabilidad horizontal en la nube"
		],
		badge: "100% Personalizado",
		badgeBg: "#fef3c7",
		badgeColor: "#d97706"
	},
	{
		id: "facturacion",
		tag: "CUMPLIMIENTO & FISCAL",
		title: "Sistemas de Facturación Electrónica",
		desc: "Implementación integral de emisión y validación de facturas electrónicas, notas de crédito, retenciones y guías de remisión adaptadas a las normativas fiscales de tu país (DIAN, SAT, SII, SUNAT, etc.).",
		features: [
			"Timbrado y validación fiscal automática",
			"Generación instantánea de XML firmado y PDF",
			"Dispersión automática por correo y WhatsApp",
			"Conciliación bancaria y pasarelas de pago"
		],
		badge: "Validación Fiscal Inmediata",
		badgeBg: "#dcfce7",
		badgeColor: "#16a34a"
	},
	{
		id: "rpa",
		tag: "AUTOMATIZACIÓN INTELIGENTE",
		title: "RPA & Bots de Procesos Automatizados",
		desc: "Robotic Process Automation para erradicar el trabajo manual repetitivo. Bots que descargan reportes, concilian archivos Excel, cargan datos a portales gubernamentales o sincronizan sistemas legacy sin API.",
		features: [
			"Bots desatendidos ejecutándose 24/7",
			"Extracción web inteligente y OCR de facturas",
			"Integración con ERPs legacy sin tocar código fuente",
			"Monitoreo de ejecución con alertas automáticas"
		],
		badge: "-85% Horas Manuales",
		badgeBg: "#f3e8ff",
		badgeColor: "#9333ea"
	},
	{
		id: "apis",
		tag: "CONECTIVIDAD & CLOUD",
		title: "APIs, Microservicios & Pasarelas de Pago",
		desc: "Conectamos todo tu ecosistema digital. Construimos APIs REST y GraphQL ultrarrápidas, webhooks en tiempo real y conectores seguros para pasarelas como Stripe, MercadoPago, PayPal y transferencias bancarias.",
		features: [
			"Documentación interactiva OpenAPI / Swagger",
			"Cifrado de extremo a extremo y OAuth 2.0",
			"Manejo de picos de tráfico con colas de mensajes",
			"Arquitectura Serverless y Microservicios"
		],
		badge: "99.99% Uptime SLA",
		badgeBg: "#e0e7ff",
		badgeColor: "#4f46e5"
	},
	{
		id: "automatizacion-ia",
		tag: "INTELIGENCIA APLICADA",
		title: "Automatizaciones con IA Generativa",
		desc: "Potenciamos tus flujos de trabajo con agentes autónomos y modelos de lenguaje: asistentes para soporte al cliente, análisis automático de contratos, categorización de leads y enriquecimiento de bases de datos.",
		features: [
			"Agentes de IA conectados a tus bases de conocimiento",
			"Clasificación automática de emails y tickets",
			"Extracción de datos no estructurados",
			"Privacidad y retención local de datos empresariales"
		],
		badge: "IA Productiva",
		badgeBg: "#ffedd5",
		badgeColor: "#ea580c"
	}
];
---

<section id="soluciones" class="services-section">
	<div class="section-container">
		<!-- Section Header -->
		<div class="section-header">
			<div class="section-badge">SOLUCIONES DE INGENIERÍA</div>
			<h2 class="section-title">
				Software diseñado para <span class="highlight">escalar tu empresa</span>
			</h2>
			<p class="section-subtitle">
				Combinamos arquitectura robusta, diseño moderno y automatización para erradicar cuellos de botella operativos y multiplicar los resultados comerciales.
			</p>
		</div>

		<!-- Services Grid -->
		<div class="services-grid">
			{services.map((item) => (
				<article class="service-card glass-card">
					<div class="card-top">
						<span class="card-tag">{item.tag}</span>
						<span class="card-badge" style={`background-color: ${item.badgeBg}; color: ${item.badgeColor};`}>
							{item.badge}
						</span>
					</div>

					<h3 class="card-title">{item.title}</h3>
					<p class="card-desc">{item.desc}</p>

					<div class="card-divider"></div>

					<ul class="features-list">
						{item.features.map((feat) => (
							<li>
								<svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span>{feat}</span>
							</li>
						))}
					</ul>

					<div class="card-footer">
						<a href="#contacto" class="card-action-link">
							<span>Consultar esta solución</span>
							<svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.services-section {
		position: relative;
		padding: clamp(60px, 9vh, 110px) clamp(20px, 4vw, 56px);
		background: #f8fafc;
	}

	.section-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		max-width: 800px;
		margin: 0 auto clamp(40px, 6vh, 64px);
	}

	.section-badge {
		display: inline-block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: #0284c7;
		margin-bottom: 14px;
		text-transform: uppercase;
		background: #e0f2fe;
		padding: 4px 12px;
		border-radius: 9999px;
	}

	.section-title {
		font-size: clamp(32px, 4.8vw, 54px);
		line-height: 1.15;
		color: #0f172a;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 16px;
	}

	.highlight {
		color: #0284c7;
	}

	.section-subtitle {
		font-size: clamp(16px, 1.6vw, 18px);
		line-height: 1.6;
		color: #475569;
	}

	/* Services Grid */
	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 28px;
	}

	.service-card {
		padding: 36px 32px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		background: #ffffff;
		border: 1px solid rgba(226, 232, 240, 0.9);
		border-radius: 18px;
		box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04), 0 8px 10px -6px rgba(15, 23, 42, 0.02);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.service-card:hover {
		transform: translateY(-4px);
		border-color: rgba(2, 132, 199, 0.4);
		box-shadow: 0 20px 35px -5px rgba(2, 132, 199, 0.12);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 18px;
	}

	.card-tag {
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #64748b;
	}

	.card-badge {
		font-size: 12px;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 20px;
	}

	.card-title {
		font-size: 22px;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.3;
		margin-bottom: 12px;
		letter-spacing: -0.02em;
	}

	.card-desc {
		font-size: 14.5px;
		line-height: 1.6;
		color: #475569;
		margin-bottom: 22px;
	}

	.card-divider {
		height: 1px;
		background: #f1f5f9;
		margin-bottom: 20px;
	}

	.features-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 28px;
	}

	.features-list li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 13.5px;
		color: #334155;
		line-height: 1.45;
	}

	.check-icon {
		width: 17px;
		height: 17px;
		color: #0284c7;
		flex-shrink: 0;
		margin-top: 1px;
	}

	.card-footer {
		margin-top: auto;
	}

	.card-action-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #0284c7;
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		transition: gap 0.2s, color 0.2s;
	}

	.card-action-link svg {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.card-action-link:hover {
		color: #0369a1;
		gap: 10px;
	}

	@media (max-width: 640px) {
		.services-grid {
			grid-template-columns: 1fr;
		}

		.service-card {
			padding: 26px 20px;
		}
	}
</style>
