---
import { products } from "../../data/products";

const labelClass =
	"font-label-stratum text-[calc(10*var(--t))] font-bold leading-none whitespace-nowrap";
const textClass =
	"t relative top-[var(--nudge)] inline-block whitespace-pre text-left";
const focusClass =
	"focus-visible:[outline:calc(1.5*var(--t))_solid_#e8d1cb] focus-visible:[outline-offset:calc(3*var(--t))]";
---

<ul
	class="index absolute top-1/2 left-[calc(10.5*var(--t))] m-0 list-none p-0 [transform:translateY(calc(-50%+1.5*var(--t)))] [@media(max-width:1152px)_and_(max-aspect-ratio:6/5)]:top-[32%] max-[548px]:top-[calc(70*var(--t))] max-[548px]:[transform:none] [.anim_&]:animate-[fadeIn_0.45s_linear_0.6s_both]"
	aria-label="Productos"
>
	{
		products.map((product, index) => (
			<li
				class:list={[
					"relative flex h-[calc(26.6*var(--t))] items-center max-[548px]:h-[calc(24*var(--t))]",
					index === 0 && "on",
					"[&.on]:before:absolute [&.on]:before:top-1/2 [&.on]:before:left-[calc(-13.5*var(--t))] [&.on]:before:h-[calc(7*var(--t))] [&.on]:before:w-[calc(6*var(--t))] [&.on]:before:bg-white [&.on]:before:content-[''] [&.on]:before:[transform:translateY(-50%)] [.anim_&.on]:before:animate-[markIn_0.42s_var(--e-soft)_0.64s_both]",
				]}
			>
				<a
					class:list={[
						labelClass,
						focusClass,
						"tracking-[calc(1.3*var(--t))] text-[rgba(232,238,250,0.3)] no-underline transition-colors duration-300 ease-[ease] hover:text-[#e6eaf5] [.on_&]:text-[#e6eaf5] max-[1152px]:py-[calc(7*var(--t))] max-[548px]:text-[rgba(232,238,250,0.42)]",
					]}
					href={`#${product.slug}`}
					aria-current={index === 0 ? "true" : undefined}
				>
					<span class={textClass}>{product.rail}</span>
				</a>
			</li>
		))
	}
</ul>
