---
import "../styles/stratum.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Vesla — Software para operar mejor",
	description = "Diseñamos software a medida, facturación electrónica, automatización y productos digitales para que tu operación funcione mejor.",
} = Astro.props;
---

<html lang="es" class="anim h-full scroll-smooth motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body
		class="min-h-full overflow-x-hidden bg-[#04070d] font-body-stratum antialiased [text-rendering:geometricPrecision]"
	>
		<slot />
		<script src="../scripts/layout/intro.ts"></script>
	</body>
</html>
