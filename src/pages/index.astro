---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Services from '../components/Services.astro';
import TechStack from '../components/TechStack.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Vesla — Empresa de Desarrollo de Software, Facturación & Automatizaciones RPA"
	description="Desarrollo de landing pages de ultra alta conversión, sistemas completos a medida, facturación electrónica fiscal y automatizaciones RPA inteligentes."
>
	<main class="page-main">
		<Hero />
		<Metrics />
		<Services />
		<TechStack />
		<Process />
		<Contact />
	</main>
	<Footer />
</Layout>

<style>
	.page-main {
		position: relative;
		overflow: hidden;
		background: #f8fafc;
	}
</style>
